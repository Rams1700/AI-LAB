# AI Robot Vacuum Cleaner - 3x3

room = [
    [1, 0, 1],
    [0, 1, 0],
    [1, 0, 0]
]

robot_row = 0
robot_col = 0

def display_room():
    for i in range(3):
        for j in range(3):
            if i == robot_row and j == robot_col:
                print("R", end=" ")
            elif room[i][j] == 1:
                print("D", end=" ")
            else:
                print(".", end=" ")
        print()
    print()

def dirt_remaining():
    for row in room:
        if 1 in row:
            return True
    return False

print("Initial Room:")
display_room()

while dirt_remaining():

    # Clean current position
    if room[robot_row][robot_col] == 1:
        print("Dirt found! Cleaning...")
        room[robot_row][robot_col] = 0

    # Move to next position
    elif robot_col < 2:
        robot_col += 1

    elif robot_row < 2:
        robot_col = 0
        robot_row += 1

    display_room()

print("All areas are clean!")
